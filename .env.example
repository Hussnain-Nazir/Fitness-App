# Vexon - environment variables
#
# Copy this file to .env and fill in your own Gemini API key before
# running the app:
#
#   cp .env.example .env
#
# .env is already declared as a Flutter asset in pubspec.yaml and is
# loaded at startup via flutter_dotenv (see lib/main.dart). It should
# never be committed - only .env.example is checked into version control.

# Your Gemini API key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model used for Nox (chat) and the AI workout generator.
MODEL_NAME=gemini-3.6-flash
